# Server-side only. Never expose these values to browser code.
SYNC_SECRET=replace-with-a-long-random-value

# Netlify injects these values in deploys. Set NETLIFY_DB_URL manually only
# when running `npm run dev` without `netlify dev`.
NETLIFY_DB_URL=
URL=http://localhost:3000

# amoCRM
AMO_BASE_URL=https://your-account.amocrm.ru
AMO_ACCESS_TOKEN=

# AlphaCRM / s20.online. Students and groups are read only from this API.
ALFA_BASE_URL=https://your-account.s20.online
ALFA_EMAIL=
ALFA_API_KEY=
# Optional comma-separated branch IDs. Leave empty to discover active branches.
ALFA_BRANCH_IDS=
